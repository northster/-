<!-- fork: the pin (a check mark while selecting) lies over the top left corner of the card instead of taking a column -->
<FrameLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
         We just need to ignore the system's audio and haptic feedback settings. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginHorizontal="10dp"
        android:hapticFeedbackEnabled="false"
        android:soundEffectsEnabled="false"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/clipboard_entry_image_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/clipboard_entry_text_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="4"/>
    </LinearLayout>

    <ImageView
            android:id="@+id/clipboard_entry_pinned_icon"
            android:contentDescription="@string/fork_clip_pin"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:layout_gravity="top|start"/>

    <!-- old card buttons, no longer shown -->
    <LinearLayout
        android:id="@+id/clipboard_entry_actions"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <ImageButton
            android:id="@+id/clipboard_entry_pin"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@null"
            android:contentDescription="@string/fork_clip_pin"
            android:src="@drawable/ic_dot_pin"/>
        <ImageButton
            android:id="@+id/clipboard_entry_delete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@null"
            android:contentDescription="@string/delete"
            android:src="@drawable/ic_dot_trash"/>
    </LinearLayout>

</FrameLayout>
