[
// fork: Samsung keyboard style bottom row
//  alphabet: !#1 | language switch | space | . | enter
//  symbols:  ABC | language switch | emoji | space | . | enter
//  the language switch key follows Settings > Keys > language switch key, the emoji key on the letters Settings > Keys > emoji key
  [
    { "label": "shift", "width": 0.15 },
    { "type": "placeholder" },
    { "label": "delete", "width": 0.15 }
  ],
  [
    { "$": "keyboard_state_selector",
      "dpad": { "label": "symbol", "width": 0.15 },
      "default": { "label": "symbol_alpha", "width": 0.15 }
    },
    { "$": "keyboard_state_selector", "languageKeyEnabled": { "label": "language_switch" } },
    { "$": "keyboard_state_selector", "emojiKeyEnabled": { "label": "emoji" }, "symbols": { "label": "emoji" }, "moreSymbols": { "label": "emoji" } },
    { "$": "variation_selector",
      "email": { "label": "@", "labelFlags": 1073741824, "groupId": 1, "type": "function" },
      "uri":   { "label": "/", "labelFlags": 1073741824, "groupId": 1, "type": "function" }
    },
    { "label": "space" },
    { "label": "period", "type": "normal", "labelFlags": 1073741824 },
    { "label": "action", "width": 0.15, "labelFlags": 1073741824 }
  ]
]
