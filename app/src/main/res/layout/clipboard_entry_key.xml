<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <!-- fork: pin toggle at the top left (a check mark while clips are selected for deletion) -->
    <ImageView
            android:id="@+id/clipboard_entry_pinned_icon"
            android:contentDescription="@string/fork_clip_pin"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:layout_gravity="top"
            android:layout_marginTop="2dp"
            android:layout_marginStart="2dp"/>

    <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
         We just need to ignore the system's audio and haptic feedback settings. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="10dp"
        android:hapticFeedbackEnabled="false"
        android:soundEffectsEnabled="false"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/clipboard_entry_image_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/clipboard_entry_text_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="4"/>
    </LinearLayout>

    <!-- fork: pin / delete right on the card -->
    <LinearLayout
        android:id="@+id/clipboard_entry_actions"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <ImageButton
            android:id="@+id/clipboard_entry_pin"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:background="@null"
            android:contentDescription="@string/fork_clip_pin"
            android:src="@drawable/ic_dot_pin"/>
        <ImageButton
            android:id="@+id/clipboard_entry_delete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:background="@null"
            android:contentDescription="@string/delete"
            android:src="@drawable/ic_dot_trash"/>
    </LinearLayout>

</LinearLayout>
