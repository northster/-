<helium314.keyboard.latin.InputView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/fakeToast"
        layout="@layout/fake_toast" />
    <!-- fork: dynamic toolbar, drawn behind the keyboard frame and moved above it by DynamicToolbarController -->
    <helium314.keyboard.fork.toolbar.DynamicToolbarView
        android:id="@+id/dynamic_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fork_dynamic_toolbar_height"
        android:layout_gravity="bottom"
        android:visibility="invisible" />
    <include
        android:id="@+id/main_keyboard_frame"
        layout="@layout/main_keyboard_frame" />
    <!-- fork: glows on the keyboard's top edge while a paste chip waits behind the collapsed toolbar.
         Drawn over the keys, not clickable, so touches go through. Placed by DynamicToolbarController. -->
    <View
        android:id="@+id/fork_chip_glow"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_gravity="bottom"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</helium314.keyboard.latin.InputView>
